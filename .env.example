# =====================================================================
# UCEST One — Environment Variables Template
# =====================================================================
# Copy this file to .env before starting docker-compose:
#   cp .env.example .env
#
# NOTE: .env is ignored by Git. Never commit real secrets.
# =====================================================================

# === Database (MySQL 8) ===
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ucest_one
MYSQL_USER=ucest_user
MYSQL_PASSWORD=ucest_password

# === Backend Service ===
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/ucest_one?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
JWT_SECRET=UcestOneSecretKeyForJwtSigningMustBeAtLeast256BitsLong2026!
JWT_EXPIRATION=7200000

# === Frontend Service ===
VITE_API_BASE_URL=/api
PORT=3000
