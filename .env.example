# =====================================================================
# UCEST One — Environment Variables Template
# =====================================================================
# Copy this file to .env before starting docker compose (PowerShell):
#   Copy-Item .env.example .env
#
# NOTE: .env is ignored by Git. Never commit real secrets.
# These are demo values for local development only.
# =====================================================================

# === Database (MySQL 8) ===
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ucest_one
MYSQL_USER=ucest_user
MYSQL_PASSWORD=ucest_password

# === Backend Service ===
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/ucest_one?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRATION=7200000

# === Host ports (change if something on your laptop already uses them) ===
# 3306 is often taken by a local MySQL service, 8080 by Jenkins.
MYSQL_PORT=3307
BACKEND_PORT=8081
FRONTEND_PORT=3000
PHPMYADMIN_PORT=8082
